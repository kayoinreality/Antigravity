# Supabase credentials.
#
# Both apps run fully without these. Leaving them unset is a supported
# configuration, not a degraded one: the canvas is local-first, so the app
# simply never syncs and the status badge reads "on this device only".
#
# Copy to .env and fill in from your Supabase project settings (API section).
# The anon key is safe to ship in a client bundle — row level security is what
# protects the data, and every table has it enabled.

# --- web (apps/web) ---
# Vite only exposes variables prefixed with VITE_ to the bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- mobile (apps/mobile) ---
# Expo only inlines variables prefixed with EXPO_PUBLIC_.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
