{
  "name": "antigravity",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev:web": "npm run dev --workspace @antigravity/web",
    "dev:mobile": "npm run start --workspace @antigravity/mobile",
    "seed": "tsx scripts/seed-notes.ts",
    "test:db": "./scripts/test-db.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.10.8",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
